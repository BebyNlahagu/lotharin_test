<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_reseller" model="ir.ui.view">
        <field name="name">res.partner.form.reseller</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_reseller_commissions" type="object"
                        class="oe_stat_button" icon="fa-money"
                        invisible="not is_reseller"
                        groups="reseller_commission.group_commission_user">
                    <field name="reseller_commission_count" widget="statinfo" string="Commissions"/>
                </button>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <widget name="web_ribbon" title="Reseller" bg_color="text-bg-info"
                        invisible="not is_reseller"/>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']//field[@name='user_id']" position="after">
                <field name="is_reseller"/>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_filter_reseller" model="ir.ui.view">
        <field name="name">res.partner.search.reseller</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="reseller" string="Resellers" domain="[('is_reseller', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="reseller_commission_reseller_action" model="ir.actions.act_window">
        <field name="name">Resellers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_reseller', '=', True)]</field>
        <field name="context">{'default_is_reseller': True, 'default_is_company': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first reseller</p>
            <p>Resellers are regular contacts flagged as reseller (Sales &amp; Purchase tab).
               Only they receive a monthly commission.</p>
        </field>
    </record>
</odoo>
