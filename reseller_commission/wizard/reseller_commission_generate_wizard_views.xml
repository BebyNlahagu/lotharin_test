<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="reseller_commission_generate_wizard_view_form" model="ir.ui.view">
        <field name="name">reseller.commission.generate.wizard.form</field>
        <field name="model">reseller.commission.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Commissions">
                <group>
                    <field name="date_from"/>
                    <field name="reseller_ids" widget="many2many_tags"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="reseller_commission_generate_wizard_action" model="ir.actions.act_window">
        <field name="name">Generate Commissions</field>
        <field name="res_model">reseller.commission.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
