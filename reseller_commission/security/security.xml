<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_reseller_commission" model="ir.module.category">
        <field name="name">Reseller Commission</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_commission_user" model="res.groups">
        <field name="name">Commission Salesperson</field>
        <field name="category_id" ref="module_category_reseller_commission"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can view the commissions of the resellers assigned to them.</field>
    </record>

    <record id="group_commission_manager" model="res.groups">
        <field name="name">Commission Manager</field>
        <field name="category_id" ref="module_category_reseller_commission"/>
        <field name="implied_ids" eval="[(4, ref('group_commission_user'))]"/>
        <field name="comment">Sees all commissions, generates, confirms and configures tiers.</field>
    </record>

    <record id="group_commission_accountant" model="res.groups">
        <field name="name">Commission Accounting</field>
        <field name="category_id" ref="module_category_reseller_commission"/>
        <field name="implied_ids" eval="[(4, ref('group_commission_user'))]"/>
        <field name="comment">Sees all commissions and marks confirmed ones as paid.</field>
    </record>

    <!-- Settings administrators (incl. the default admin) get the full commission rights. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_commission_manager')), (4, ref('group_commission_accountant'))]"/>
    </record>
</odoo>
